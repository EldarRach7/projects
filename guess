import random
def guess1To10():
    number = random.randint(1,10)
    guess = int(input(" guess a number between 1 and 10 :"))
    guessesAmount = 1
    while guess != number:
        print("wrong guess, try again!")
        if(guess < number):
            print("too low")
        elif(guess > number):
            print("too high")
        guessesAmount+=1
        guess = int(input("guess again"))
    print(" congratz you were right! it took you " + str(guessesAmount) + " tries to get it right")
guess1To10()
